  "models": [
    {
      "id": "gemma3_12b",
      "name": "gemma3:12b",
      "file_types": ["text", "image"]
    }
  ],
  "prompts": {
    "text": [
      {
        "id": "allan_custom",
        "prompt": "You will categorize content using tags. You MUST ONLY choose tags from this list: \n{tag_list}. \n\nDo NOT create any new tags. Return the tags as a comma-separated list.\n\nHere is the content to categorize: \n\n{text}",
        "options": {
          "temperature": 0.05,
          "num_predict": 50
        }
      },
      {
        "id": "strict_basic",
        "prompt": "Select the most appropriate tags for the following content. You must ONLY choose from this list: {tag_list}. Do not create any new tags. Return the tags as a comma-separated list.\n\nContent: {text}\n\nTags:",
        "options": {
          "temperature": 0.1,
          "num_predict": 50
        }
      },
      {
        "id": "strict_negative",
        "prompt": "Classify the text using ONLY the tags provided below.\n\nALLOWED TAGS: {tag_list}\n\nNEGATIVE CONSTRAINTS:\n- Do NOT use any tags not in the list.\n- Do NOT explain your reasoning.\n- Do NOT output full sentences.\n\nContent: {text}\n\nTags:",
        "options": {
          "temperature": 0.0,
          "num_predict": 50
        }
      },
      {
        "id": "strict_auditor",
        "prompt": "You are a strict Data Auditor. Your job is to categorize documents using a fixed taxonomy. \n\nTaxonomy: {tag_list}\n\nInstructions:\n1. Read the content.\n2. Select 1-5 tags from the Taxonomy that best fit.\n3. Output ONLY the selected tags, separated by commas.\n\nContent: {text}\n\nTags:",
        "options": {
          "temperature": 0.05,
          "num_predict": 50
        }
      }
    ],
    "image": [
      {
        "id": "img_basic",
        "prompt": "Analyze this image and describe it using ONLY tags from this list: {tag_list}. Return comma-separated tags.",
        "options": {
          "temperature": 0.2,
          "num_predict": 50
        }
      }
    ]
  }
}
